{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thecbah/devcontainer.pytorch-image-models/schemas/cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decoded_image_key": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "op": {
                  "enum": [
                    "resize",
                    "crop",
                    "pad"
                  ]
                },
                "before": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "padding": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "fill": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  ]
                }
              },
              "required": [
                "op",
                "before",
                "after"
              ]
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tensor_key": {
                  "type": "string",
                  "minLength": 1
                },
                "tensor": {
                  "$ref": "tensor.schema.json"
                }
              },
              "required": [
                "tensor_key",
                "tensor"
              ]
            }
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tensor_key": {
                  "type": "string",
                  "minLength": 1
                },
                "tensor": {
                  "$ref": "tensor.schema.json"
                }
              },
              "required": [
                "tensor_key",
                "tensor"
              ]
            }
          }
        },
        "required": [
          "id",
          "decoded_image_key",
          "geometry",
          "inputs",
          "outputs"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "cases"
  ]
}
